# ============================================================
# Arquivo de exemplo de variáveis de ambiente
# Copie para .env e preencha com os valores reais
# ============================================================

# --- Servidor ---
NODE_ENV=development
PORT=9999
API_URL=http://localhost:9999

# --- MongoDB ---
MONGODB_URI=mongodb://localhost:27017/multibots
MONGODB_URI_TEST=mongodb://localhost:27017/multibots_test

# --- JWT ---
JWT_SECRET=TROCAR_POR_CHAVE_SECRETA_FORTE_MIN_64_CHARS
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=TROCAR_POR_OUTRA_CHAVE_SECRETA_FORTE
JWT_REFRESH_EXPIRES_IN=30d

# --- CORS ---
# Lista de origens permitidas separadas por vírgula
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,https://multibot.ghoststore.cc

# --- Rate Limiting ---
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX=10
PURCHASE_RATE_LIMIT_MAX=30

# --- Upload ---
MAX_FILE_SIZE_MB=5
UPLOAD_DIR=./uploads

# --- PIX (Gateway de Pagamento) ---
PIX_GATEWAY_URL=https://api.gateway.com/pix
PIX_API_KEY=
PIX_SECRET=
PIX_WEBHOOK_SECRET=TROCAR_POR_SEGREDO_WEBHOOK_PIX

# --- NOWPayments (Cripto) ---
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=TROCAR_POR_SEGREDO_IPN_NOWPAYMENTS
NOWPAYMENTS_ENDPOINT=https://api.nowpayments.io
NOWPAYMENTS_CALLBACK_URL=https://multibot.ghoststore.cc/api/webhooks/crypto/callback

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=

# --- Checker ---
CHECKER_API_URL=
CHECKER_API_KEY=
# Tempo máximo de resposta do checker em ms
CHECKER_TIMEOUT_MS=30000

# --- Fornecedor (Supplier) ---
SUPPLIER_API_URL=
SUPPLIER_API_KEY=
SUPPLIER_WEBHOOK_SECRET=TROCAR_POR_SEGREDO_SUPPLIER

# --- Super Admin ---
SUPER_ADMIN_EMAIL=admin@multibots.cc
SUPER_ADMIN_PASSWORD=TROCAR_POR_SENHA_FORTE

# --- Logs ---
LOG_LEVEL=info
LOG_FILE=./logs/app.log

# --- Socket.IO ---
SOCKET_IO_CORS_ORIGIN=http://localhost:3000

# --- Fornecedor Externo (Api-MultiBot-Ghost) ---
# URL da API que espelha a vitrine do marketplace principal
# Em Docker: http://ghost-multibot-api:3003
SUPPLIER_API_URL=http://localhost:3003
SUPPLIER_API_KEY=
