# Dockerfile.frontend — Build multi-estagio do frontend Vite + Nginx
#
# Estagio 1: Instala dependencias do frontend
# Estagio 2: Build do Vite (gera arquivos estaticos)
# Estagio 3: Nginx serve os arquivos compilados
#
# Build: docker build -f docker/Dockerfile.frontend -t multibots-frontend .

# === Estagio 1: Dependencias ===
FROM node:20-alpine AS deps

WORKDIR /app/frontend

# Copia apenas arquivos de dependencia do frontend
COPY frontend/package.json frontend/package-lock.json* frontend/yarn.lock* frontend/pnpm-lock.yaml* ./

# Instala todas as dependencias (incluindo devDependencies para o build)
RUN if [ -f pnpm-lock.yaml ]; then \
      corepack enable pnpm && pnpm install --frozen-lockfile; \
    elif [ -f yarn.lock ]; then \
      yarn install --frozen-lockfile; \
    elif [ -f package-lock.json ]; then \
      npm ci; \
    else \
      npm install; \
    fi

# === Estagio 2: Build ===
FROM node:20-alpine AS builder

WORKDIR /app/frontend

# Copia dependencias do estagio anterior
COPY --from=deps /app/frontend/node_modules ./node_modules

# Copia codigo-fonte do frontend
COPY frontend/ .

# Variaveis de ambiente para o build do Vite
ARG VITE_API_URL=/api
ARG VITE_APP_NAME=MultiBots
ENV VITE_API_URL=${VITE_API_URL}
ENV VITE_APP_NAME=${VITE_APP_NAME}

# Executa o build do Vite
RUN npm run build

# === Estagio 3: Nginx (producao) ===
FROM nginx:1.25-alpine AS production

# Metadados da imagem
LABEL maintainer="MultiBots Platform"
LABEL description="Frontend da plataforma MultiBots (Vite + Nginx)"

# Remove configuracao padrao do Nginx
RUN rm -rf /etc/nginx/conf.d/default.conf /usr/share/nginx/html/*

# Copia configuracao customizada do Nginx
COPY docker/nginx.conf /etc/nginx/conf.d/default.conf

# Copia arquivos compilados do Vite
COPY --from=builder /app/frontend/dist /usr/share/nginx/html

# Cria usuario nao-root (nginx ja roda como nginx user)
RUN chown -R nginx:nginx /usr/share/nginx/html && \
    chmod -R 755 /usr/share/nginx/html && \
    # Diretorio de cache do nginx precisa ser gravavel
    chown -R nginx:nginx /var/cache/nginx && \
    chown -R nginx:nginx /var/log/nginx && \
    chown -R nginx:nginx /etc/nginx/conf.d && \
    # Cria pid file acessivel
    touch /var/run/nginx.pid && \
    chown -R nginx:nginx /var/run/nginx.pid

# Troca para usuario nao-root
USER nginx

# Expoe porta HTTP
EXPOSE 80

# Healthcheck
HEALTHCHECK --interval=30s --timeout=5s --retries=3 \
  CMD wget --no-verbose --tries=1 --spider http://localhost:80 || exit 1

# Inicia Nginx em foreground
CMD ["nginx", "-g", "daemon off;"]
